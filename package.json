{
  "name": "masterservice-server",
  "version": "1.0.0",
  "description": "MasterService Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "build": "npm install --include=dev && tsc",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "start:dev": "cross-env NODE_ENV=development node dist/server.js",
    "seed": "cross-env NODE_ENV=development tsx src/seed.ts",
    "reset:data": "cross-env NODE_ENV=development tsx src/scripts/reset-data.ts",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.16.0",
    "multer": "^2.0.0",
    "node-cron": "^4.6.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.33.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0",
    "vitest": "^4.1.11"
  }
}
